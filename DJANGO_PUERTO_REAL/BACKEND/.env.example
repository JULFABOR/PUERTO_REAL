# Example .env for DJANGO_PUERTO_REAL
# Copy this file to `.env` and fill with real values (do NOT commit secrets)

# Environment: development or production
# Use 'development' for local testing (allows HTTP, no SSL redirect)
# Use 'production' for deployed systems (forces HTTPS, security headers)
ENVIRONMENT=development

# Django
SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False

# Frontend/Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL example)
DB_NAME=puerto_real_db
DB_USER=puerto_user
DB_PASSWORD=strong_db_password
DB_HOST=localhost
DB_PORT=3306

# Email (Gmail example: use app password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
